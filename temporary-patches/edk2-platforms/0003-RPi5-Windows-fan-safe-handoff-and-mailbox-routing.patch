diff --git a/Platform/RaspberryPi/RPi5/Drivers/RpiPlatformDxe/FanControl.c b/Platform/RaspberryPi/RPi5/Drivers/RpiPlatformDxe/FanControl.c
--- a/Platform/RaspberryPi/RPi5/Drivers/RpiPlatformDxe/FanControl.c
+++ b/Platform/RaspberryPi/RPi5/Drivers/RpiPlatformDxe/FanControl.c
@@ -214,10 +214,13 @@ FanExitBootServices (
   (VOID)Event;
   (VOID)Context;
 
-  // UEFI timers do not run after ExitBootServices. Persistent mode leaves the
-  // last PWM value active; all other modes restore the pre-UEFI RP1 state.
-  if ((mRp1Bus != NULL) && (mFanMode.Value != FAN_MODE_PERSISTENT)) {
-    mRp1Bus->RestoreFanState (mRp1Bus);
+  // Windows must always inherit a running fan. Establish the 100% fail-safe
+  // before Boot Services disappear and let the Windows driver reduce speed
+  // only after it has successfully entered D0. If the driver is absent or
+  // fails to start, the RP1 PWM registers retain this programmed state.
+  if (mRp1Bus != NULL) {
+    (VOID)mRp1Bus->SetFanSpeed (mRp1Bus, FAN_FAIL_SAFE_SPEED);
   }
 }

diff --git a/Platform/RaspberryPi/RPi5/Drivers/RpiPlatformDxe/RpiPlatformDxeHii.uni b/Platform/RaspberryPi/RPi5/Drivers/RpiPlatformDxe/RpiPlatformDxeHii.uni
