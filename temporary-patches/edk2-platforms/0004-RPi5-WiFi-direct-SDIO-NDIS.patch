+typedef enum {
+  Bcm2712PinctrlUnknown,
+  Bcm2712PinctrlC0,
+  Bcm2712PinctrlD0
+} BCM2712_PINCTRL_REVISION;
+
+STATIC
+BCM2712_PINCTRL_REVISION
+GetBcm2712PinctrlRevision (
+  VOID
+  )
+{
+  CONST VOID  *Fdt;
+
+  Fdt = FdtPlatformGetBase ();
+  if ((Fdt == NULL) || (FdtCheckHeader (Fdt) != 0)) {
+    DEBUG ((DEBUG_WARN, "%a: No valid firmware device tree; preserving D0 pinctrl fallback\n", __func__));
+    return Bcm2712PinctrlUnknown;
+  }
+
+  if (FdtNodeOffsetByCompatible (Fdt, -1, "brcm,bcm2712d0-pinctrl") >= 0) {
+    return Bcm2712PinctrlD0;
+  }
+
+  if (FdtNodeOffsetByCompatible (Fdt, -1, "brcm,bcm2712c0-pinctrl") >= 0) {
+    return Bcm2712PinctrlC0;
+  }
+
+  DEBUG ((DEBUG_WARN, "%a: Unknown BCM2712 pinctrl compatible; preserving D0 pinctrl fallback\n", __func__));
+  return Bcm2712PinctrlUnknown;
+}
