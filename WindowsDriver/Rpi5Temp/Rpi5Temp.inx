[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=08/18/2026,2026.8.18.6
CatalogFile=Rpi5Temp.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=13

[SourceDisksNames]
1=%DiskName%,,,""

[SourceDisksFiles]
Rpi5Temp.sys=1,,

[Manufacturer]
%Manufacturer%=Devices,NT$ARCH$.10.0...22000

[Devices.NT$ARCH$.10.0...22000]
%DeviceDesc%=Temp_Install,ACPI\RPI0010

[Temp_Install.NT]
CopyFiles=DriverCopy

[DriverCopy]
Rpi5Temp.sys

[Temp_Install.NT.Services]
AddService=Rpi5Temp,%SPSVCINST_ASSOCSERVICE%,Temp_Service

[Temp_Service]
DisplayName=%ServiceDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\Rpi5Temp.sys

[Temp_Install.NT.Wdf]
KmdfService=Rpi5Temp,Temp_Wdf

[Temp_Wdf]
KmdfLibraryVersion=$KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE=0x00000002
Provider="RPi5 UEFI Community"
Manufacturer="RPi5 UEFI Community"
DiskName="Raspberry Pi 5 temperature provider package"
DeviceDesc="Raspberry Pi 5 SoC Temperature Provider"
ServiceDesc="Raspberry Pi 5 SoC Temperature Provider Driver"
