<Window x:Class="Rpi5FanControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Raspberry Pi 5 Fan Control"
        Width="930" Height="730" MinWidth="780" MinHeight="630"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Raspberry Pi 5 Active Cooler" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="exp.6 split-driver control, safety status, and telemetry for Windows 11 ARM64" Opacity="0.7" Margin="0,4,0,0" />
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,14">
            <Border BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="SoC temperature" Opacity="0.65" />
                    <TextBlock x:Name="TemperatureText" Text="--" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0" />
                    <TextBlock x:Name="TempProviderText" Text="Provider: waiting" FontSize="11" Opacity="0.65" />
                </StackPanel>
            </Border>
            <Border BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Fan output" Opacity="0.65" />
                    <TextBlock x:Name="FanPercentText" Text="--" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0" />
                    <TextBlock Text="Commanded PWM; not RPM" FontSize="11" Opacity="0.6" />
                </StackPanel>
            </Border>
            <Border BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Control mode" Opacity="0.65" />
                    <TextBlock x:Name="ModeText" Text="--" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel>
                    <TextBlock Text="Fan driver" Opacity="0.65" />
                    <TextBlock x:Name="DriverText" Text="Connecting..." FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" x:Name="SafetyBorder" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Safety: " FontWeight="SemiBold" />
                <TextBlock x:Name="SafetyText" Text="Waiting for driver telemetry." TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Row="0" Grid.Column="0" Content="Automatic" Padding="18,8" Margin="0,0,12,0" Click="Automatic_Click" />
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Manual" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Slider x:Name="ManualSlider" Minimum="30" Maximum="100" Value="50" TickFrequency="5" IsSnapToTickEnabled="True" Width="230" ValueChanged="ManualSlider_ValueChanged" />
                    <TextBlock x:Name="ManualValueText" Text="50%" Width="48" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
                <Button Grid.Row="0" Grid.Column="2" Content="Apply Manual" Padding="16,8" Margin="12,0,8,0" Click="Manual_Click" />
                <Button Grid.Row="0" Grid.Column="3" Content="Force 100%" Padding="16,8" Click="FailSafe_Click" />

                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,12,0,0" TextWrapping="Wrap" Opacity="0.7"
                           Text="Manual control is limited to 30–100%. Missing/invalid temperature telemetry or SoC temperature at or above 85°C forces the fan to 100%." />
            </Grid>
        </Border>

        <GroupBox Grid.Row="4" Header="Recent log" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListBox x:Name="RecentLogList" FontFamily="Consolas" FontSize="12" />
                <TextBlock Grid.Row="1" x:Name="LogPathText" Margin="4,8,4,0" Opacity="0.65" TextWrapping="Wrap" />
            </Grid>
        </GroupBox>

        <TextBlock Grid.Row="5" x:Name="FooterText" Margin="0,12,0,0" Opacity="0.65"
                   Text="Actual fan RPM is not reported yet because tachometer input is not implemented in the driver." />
    </Grid>
</Window>
