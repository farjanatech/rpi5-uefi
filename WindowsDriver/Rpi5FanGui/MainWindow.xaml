<Window x:Class="Rpi5FanControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Raspberry Pi 5 Fan Control"
        Icon="Assets/fan.ico"
        Width="1080" Height="790" MinWidth="940" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#08111F"
        Foreground="#F7FAFF"
        FontFamily="Segoe UI">
    <Window.Resources>
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#17233B" Offset="0" />
            <GradientStop Color="#0E1A2E" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="FanGlow" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#17334A" Offset="0" />
            <GradientStop Color="#121F34" Offset="0.55" />
            <GradientStop Color="#29193B" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="CardBackground" Color="#111C2E" />
        <SolidColorBrush x:Key="CardBorder" Color="#243552" />
        <SolidColorBrush x:Key="MutedText" Color="#94A7C5" />
        <SolidColorBrush x:Key="Cyan" Color="#55D6E8" />
        <SolidColorBrush x:Key="Orange" Color="#FFB454" />
        <SolidColorBrush x:Key="Purple" Color="#B693FF" />
        <SolidColorBrush x:Key="Green" Color="#52E0A4" />
        <SolidColorBrush x:Key="Red" Color="#FF6B7B" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F7FAFF" />
            <Setter Property="FontSize" Value="27" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#071019" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="340" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" BorderBrush="#243552" BorderThickness="1"
                CornerRadius="20" Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="58" Height="58" CornerRadius="14" Background="#F8FAFF" Padding="6" Margin="0,0,14,0">
                    <Image Source="Assets/fan.png" Stretch="Uniform" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Raspberry Pi 5 Active Cooler" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="Windows 11 ARM64 · exp.6.1 visual refresh · verified exp.6 backend"
                               Foreground="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>

                <Border Grid.Column="2" x:Name="ConnectionBadge" CornerRadius="14" Background="#193C34"
                        BorderBrush="#2F8C73" BorderThickness="1" Padding="14,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ConnectionIndicator" Width="8" Height="8" Fill="{StaticResource Green}" Margin="0,0,8,0" />
                        <TextBlock x:Name="ConnectionBadgeText" Text="Connecting" Foreground="#D8FFF0" FontWeight="SemiBold" FontSize="12" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="405" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Background="{StaticResource FanGlow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <TextBlock Text="FAN OUTPUT" Style="{StaticResource MetricLabel}" />
                        <Border HorizontalAlignment="Right" CornerRadius="9" Background="#182841" Padding="9,5">
                            <TextBlock Text="PWM" Foreground="{StaticResource Cyan}" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Ellipse Width="236" Height="236" Fill="#0A1424" Stroke="#2C4968" StrokeThickness="1" />
                        <Ellipse Width="214" Height="214" Fill="#FFFFFF" Opacity="0.98" />
                        <Image x:Name="FanImage" Source="Assets/fan.png" Width="205" Height="205"
                               Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <RotateTransform x:Name="FanRotateTransform" Angle="0" />
                            </Image.RenderTransform>
                        </Image>
                    </Grid>

                    <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                        <TextBlock x:Name="FanPercentText" Text="--" FontSize="38" FontWeight="Bold"
                                   Foreground="{StaticResource Cyan}" HorizontalAlignment="Center" />
                        <TextBlock Text="Commanded fan output" Foreground="{StaticResource MutedText}" FontSize="12"
                                   HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DockPanel>
                            <Ellipse Width="10" Height="10" Fill="{StaticResource Orange}" Margin="0,2,8,0" DockPanel.Dock="Left" />
                            <TextBlock Text="SOC TEMPERATURE" Style="{StaticResource MetricLabel}" />
                        </DockPanel>
                        <TextBlock Grid.Row="1" x:Name="TemperatureText" Text="--" Style="{StaticResource MetricValue}" FontSize="32" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Text="Live thermal telemetry" Foreground="{StaticResource MutedText}" FontSize="11" />
                    </Grid>
                </Border>

                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DockPanel>
                            <Ellipse Width="10" Height="10" Fill="{StaticResource Purple}" Margin="0,2,8,0" DockPanel.Dock="Left" />
                            <TextBlock Text="CONTROL MODE" Style="{StaticResource MetricLabel}" />
                        </DockPanel>
                        <TextBlock Grid.Row="1" x:Name="ModeText" Text="--" Style="{StaticResource MetricValue}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Text="Driver-side control state" Foreground="{StaticResource MutedText}" FontSize="11" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DockPanel>
                            <Ellipse x:Name="DriverIndicator" Width="10" Height="10" Fill="{StaticResource Green}" Margin="0,2,8,0" DockPanel.Dock="Left" />
                            <TextBlock Text="FAN DRIVER" Style="{StaticResource MetricLabel}" />
                        </DockPanel>
                        <TextBlock Grid.Row="1" x:Name="DriverText" Text="Connecting..." Style="{StaticResource MetricValue}" FontSize="24" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Text="ACPI\RPI000F" Foreground="{StaticResource MutedText}" FontFamily="Consolas" FontSize="11" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DockPanel>
                            <Ellipse x:Name="TempProviderIndicator" Width="10" Height="10" Fill="{StaticResource Cyan}" Margin="0,2,8,0" DockPanel.Dock="Left" />
                            <TextBlock Text="TEMP PROVIDER" Style="{StaticResource MetricLabel}" />
                        </DockPanel>
                        <TextBlock Grid.Row="1" x:Name="TempProviderText" Text="Waiting" Style="{StaticResource MetricValue}" FontSize="20" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Text="ACPI\RPI0010" Foreground="{StaticResource MutedText}" FontFamily="Consolas" FontSize="11" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" x:Name="SafetyBorder" CornerRadius="14" Background="#15362E" BorderBrush="#2E7B68"
                BorderThickness="1" Padding="15" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="SafetyIndicator" Width="11" Height="11" Fill="{StaticResource Green}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="SAFETY" FontSize="12" FontWeight="Bold" Foreground="#C6FFE8" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Grid.Column="2" x:Name="SafetyText" Text="Waiting for driver telemetry." Foreground="#E5FFF6" TextWrapping="Wrap" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="0.95*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="CONTROL" FontSize="13" FontWeight="Bold" Foreground="#DDE8FA" />

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Automatic" Style="{StaticResource ActionButton}" Background="{StaticResource Cyan}" Click="Automatic_Click" Margin="0,0,10,0" />
                        <Button Content="Apply Manual" Style="{StaticResource ActionButton}" Background="{StaticResource Purple}" Click="Manual_Click" Margin="0,0,10,0" />
                        <Button Content="Force 100%" Style="{StaticResource ActionButton}" Background="{StaticResource Red}" Foreground="#FFFFFF" Click="FailSafe_Click" />
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="58" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Manual" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Slider Grid.Column="1" x:Name="ManualSlider" Minimum="30" Maximum="100" Value="50"
                                TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                ValueChanged="ManualSlider_ValueChanged" />
                        <Border Grid.Column="2" CornerRadius="8" Background="#1C2B44" Margin="10,0,0,0" Padding="8,5">
                            <TextBlock x:Name="ManualValueText" Text="50%" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource Purple}" />
                        </Border>
                    </Grid>

                    <TextBlock Grid.Row="3" Margin="0,15,0,0" Foreground="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap"
                               Text="Manual control is limited to 30–100%. Invalid temperature telemetry or 85°C+ forces the 100% safety command." />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="RECENT ACTIVITY" FontSize="13" FontWeight="Bold" Foreground="#DDE8FA" />
                    <ListBox Grid.Row="1" x:Name="RecentLogList" Margin="0,12,0,0" Background="#0B1525" BorderBrush="#21334E"
                             BorderThickness="1" Foreground="#BED0E9" FontFamily="Consolas" FontSize="11" Padding="6" />
                    <TextBlock Grid.Row="2" x:Name="LogPathText" Margin="0,9,0,0" Foreground="{StaticResource MutedText}" FontSize="10" TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="2,12,2,0">
            <TextBlock Text="Temperature-aware fan control continues in the kernel even when this window is closed."
                       Foreground="#7185A4" FontSize="10" />
            <TextBlock HorizontalAlignment="Right" Text="RPi5 Fan Control · exp.6.1" Foreground="#7185A4" FontSize="10" />
        </Grid>
    </Grid>
</Window>
